{
    "compilerOptions": {
      "target": "ES2020",                     // Set the target version of JavaScript
      "module": "commonjs",                    // Module system to use (commonjs is standard for Node.js)
      "moduleResolution": "node",              // Use Node.js module resolution strategy
      "strict": true,                          // Enable strict type checking
      "esModuleInterop": true,                 // Allow default imports from non-ESM modules
      "skipLibCheck": true,                    // Skip type checking of declaration files for faster builds
      "forceConsistentCasingInFileNames": true,// Ensure consistent casing in file imports
      "outDir": "./dist",                      // Set the output directory for compiled JavaScript files
      "baseUrl": ".",                          // Set base URL for resolving non-relative module imports
      "paths": {
        "shared/*": ["shared/*"]               // Aliases to easily refer to shared folder
      }
    },
    "include": [
      "auth-service/src/**/*",   // Include source code for auth-service
      "order-service/src/**/*",  // Include source code for order-service
      "shared/**/*"              // Include the shared folder for both services
    ],
    "exclude": [
      "node_modules",            // Exclude node_modules from the compilation
      "dist"                     // Exclude the dist folder (output folder)
    ]
  }
  